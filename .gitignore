# python / env
code/.venv/
__pycache__/
*.pyc
.pytest_cache/
# large artifacts stay on the GPU machine's NVMe
# data/ and runs/ are symlinks to the NVMe on the GPU machine (no trailing slash, so the links themselves are ignored);
# per-run results are exported to code/results/runs/ by scripts/export_results.py and tracked there
code/data
code/runs
*.bin
*.pt
# editors / os
*.swp
.DS_Store
*.egg-info/
*.log
nohup.out
